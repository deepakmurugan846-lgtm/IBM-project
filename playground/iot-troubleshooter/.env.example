# .env — IoT Troubleshooter configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: LLM settings ────────────────────────────────────────────────
# Available Groq models: qwen/qwen3.8-27b, openai/gpt-oss-120b, allam-2-7b
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# ── Optional: Embedding model ─────────────────────────────────────────────
# Change to a larger model for better retrieval accuracy (slower first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Optional: Chunking ────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Optional: Retrieval ───────────────────────────────────────────────────
RETRIEVAL_TOP_K=5

# ── Optional: Conversation ────────────────────────────────────────────────
MAX_HISTORY_TURNS=10

# ── Optional: API server ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Optional: Frontend ────────────────────────────────────────────────────
# URL the Streamlit UI uses to reach the backend
API_BASE_URL=http://localhost:8000
